# LLM: "claude" / "openai" / "deepseek"
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# DashScope (千问) API key for embedding + reranker
DASHSCOPE_API_KEY=sk-

# Embedding: "bge_m3" / "openai" / "dashscope" (千问 text-embedding-v4, 1024-dim)
EMBEDDING_PROVIDER=dashscope

# Reranker: "bge_reranker" / "openai" / "dashscope" (千问 qwen3-rerank)
RERANKER_PROVIDER=dashscope

# Milvus mode: "lite" or "standalone"
MILVUS_MODE=lite
MILVUS_URI=./data/milvus_lite
# MILVUS_URI=http://localhost:19530  # for standalone
